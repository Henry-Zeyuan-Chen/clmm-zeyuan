# Everything is ignored unless allowed below. A folder must be allowed
# (with its subfolders) before any file inside it can be.
*

!/.gitignore
!/LICENSE
!/README.md
!/SETUP.md
!/pyproject.toml
!/requirements-lock.txt

!/clmm/
!/clmm/**/
!/clmm/**/*.py
!/clmm/**/.gitignore

!/data/
!/data/README.md
!/data/enwik8.gz

!/docs/
!/docs/*.md

!/results/
!/results/**/
!/results/**/*.txt
!/results/**/*.json
!/results/**/*.yaml
!/results/**/*.csv
!/results/**/*.png

!/scripts/
!/scripts/*.py

!/tests/
!/tests/**/
!/tests/**/*.py

!/titans_pytorch/
!/titans_pytorch/*.py

!/upstream/
!/upstream/README.md
!/upstream/*.png
!/upstream/*.py

!/.github/
!/.github/**/
!/.github/**/*.yml
